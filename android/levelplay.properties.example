# Copy this file to android/levelplay.properties (gitignored -- never commit
# it) and fill in the app key and ad unit IDs from the Unity LevelPlay
# dashboard: https://platform.ironsrc.com (LevelPlay > Setup > Ad units).
#
# Leave appKey blank, or don't create this file at all, to keep ads
# disabled: the LevelPlay SDK and LevelPlayPlugin.java are then left out of
# the build, so a fresh checkout without this file still builds and runs
# fine with ads simply absent (same fallback shape as
# android/keystore.properties for release signing).

appKey=
bannerAdUnitId=
interstitialAdUnitId=
rewardedContinueAdUnitId=
rewardedHintsAdUnitId=
rewardedUndosAdUnitId=

# Meta Audience Network via LevelPlay. Set to true only after the Meta app
# and placement IDs are entered in LevelPlay (Setup > SDK Networks).
metaEnabled=false

# true opens LevelPlay's Test Suite right after init, to check each network
# on a device. Never ship a release build with this on.
testSuite=false
