# Copy this file to android/applovin.properties (gitignored -- never commit
# real values) and fill in the SDK key and ad unit IDs from your AppLovin
# MAX dashboard: https://dash.applovin.com
#
# Leave sdkKey blank, or don't create this file at all, to keep ads
# disabled: AppLovinPlugin.java checks for a non-empty key before ever
# initializing the AppLovin SDK, so a fresh checkout without this file
# still builds and runs fine with ads simply absent (same fallback shape
# as android/keystore.properties for release signing).

sdkKey=
bannerAdUnitId=
interstitialAdUnitId=
rewardedAdUnitId=

# Meta Audience Network via MAX. Set to true only after the Meta app and
# placement IDs are entered in the MAX dashboard (Mediation > Networks).
metaEnabled=false
